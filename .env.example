# 이 파일을 복사해서 .env 로 이름 바꾸고 값 채우면 됨

# ==== DB (MySQL / AWS RDS) ====
DB_HOST=                      # AWS RDS 엔드포인트
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=fish

# ==== API ====
# FastAPI 서버 주소 (PyQt, arduino_link에서 이걸 보고 호출)
API_BASE_URL=http://localhost:8000

# ==== Arduino 시리얼 ====
SERIAL_PORT=/dev/ttyACM0       # 우분투에서 아두이노가 잡힌 포트
SERIAL_BAUDRATE=115200
